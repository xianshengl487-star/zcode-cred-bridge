{
  "name": "zcode-cred-bridge",
  "version": "1.0.0",
  "description": "把 ZCode 桌面客户端已登录的智谱 BigModel 账号搬进 DSH，让 dsh-llm-zcode 的 zcode-cn 路由直接可用。",
  "type": "module",
  "bin": {
    "zcode-cred-bridge": "import-zcode.mjs"
  },
  "main": "import-zcode.mjs",
  "files": [
    "import-zcode.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "zcode",
    "bigmodel",
    "zhipu",
    "glm",
    "coding-plan",
    "credential-bridge"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node import-zcode.mjs --check",
    "dry-run": "node import-zcode.mjs --dry-run",
    "import": "node import-zcode.mjs"
  }
}
